{
  "name": "KGlance",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    // The build is CGO-free (Wails' purego backend): no GTK, no C compiler. Every go command needs the tag.
    "CGO_ENABLED": "0",
    "GOFLAGS": "-tags=purego",
    // The frontend dev server (`cd frontend && npm run dev`) listens here; ?demo=battery|charging|low|ac shows
    // the popup in a fixed power state without the Go side. Bind to all interfaces so the editor's port
    // forward reaches it.
    "WAILS_VITE_PORT": "9245"
  },
  // Installs the frontend packages, the Go modules, the wails3 CLI (`make bindings`) and the Go dev tools.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [9245],
  "portsAttributes": {
    "9245": { "label": "Popup (npm run dev, add ?demo=charging)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "biomejs.biome"],
      "settings": {
        "go.toolsEnvVars": { "CGO_ENABLED": "0", "GOFLAGS": "-tags=purego" },
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--config=${workspaceFolder}/.github/linters/golangci.yml"],
        "go.lintOnSave": "workspace",
        "editor.formatOnSave": true,
        "go.formatTool": "goimports",
        "[go]": { "editor.defaultFormatter": "golang.go" },
        "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[css]": { "editor.defaultFormatter": "biomejs.biome" },
        "[html]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" },
        "[markdown]": { "editor.formatOnSave": false }
      }
    }
  }
}
