# Binaries and test output
*.exe
*.so
*.dylib
*.test
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov
*.prof

# Go workspace
go.work
go.work.sum

# Build output: `go build .` names the binary after the module, so it lands in the repo root.
/kglance
/bin/
/dist/

# Frontend (Vite). dist/ is build output embedded by main.go; only the placeholder is tracked so
# `go vet` and `go test` work before the frontend has been built.
node_modules/
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
.vite/
npm-debug.log*

# Secrets and local state
.env
.env.*
!.env.example
*.pem
*.key

# Editors and OS
.idea/
*.iml
*.swp
*~
.DS_Store

# AI assistant local settings
.claude/settings.local.json
.claude/scratch/

# Screenshots and scratch output (rendered in CI by screenshots.yml, never committed)
/shots/
/screenshots/
