[Desktop Entry]
Version=1.0
Type=Application
Name=KGlance
Comment=Starts KGlance in the background so its shortcut works
Exec=/usr/bin/kglance --background
Icon=io.github.cthtrifork.kglance
Terminal=false
NoDisplay=true
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
X-GNOME-Autostart-enabled=true
