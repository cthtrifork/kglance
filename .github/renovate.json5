{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  labels: [
    'dependencies',
  ],
  semanticCommits: 'enabled',
  semanticCommitType: 'deps',
  semanticCommitScope: null,
  minimumReleaseAge: '2 days',
  internalChecksFilter: 'strict',
  postUpdateOptions: [
    'gomodTidy',
  ],
  platformCommit: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Dependency Dashboard',
  dependencyDashboardLabels: [
    'dependencies',
  ],
  osvVulnerabilityAlerts: true,
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
    semanticCommitType: 'security',
  },
  packageRules: [
    {
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'actions',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'go-minor',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'frontend-minor',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      groupName: 'dev tools',
    },
    {
      matchPackageNames: [
        'golangci/golangci-lint',
        'golangci/golangci-lint-action',
      ],
      groupName: 'golangci-lint',
    },
    {
      matchDepNames: [
        'go',
        'golang',
        'mirror.gcr.io/library/golang',
      ],
      groupName: 'go toolchain',
      automerge: false,
    },
    {
      matchDepNames: [
        'nodejs',
        'node',
        'mirror.gcr.io/library/node',
      ],
      groupName: 'node',
      automerge: false,
    },
    {
      matchPackageNames: [
        'github.com/wailsapp/wails/v3',
        '@wailsio/runtime',
      ],
      groupName: 'wails',
      automerge: false,
    },
    {
      matchPackageNames: [
        'github.com/ebitengine/purego',
      ],
      automerge: false,
    },
    {
      matchDepNames: [
        'registry.fedoraproject.org/fedora',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Makefile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?\\S+\\s*(?::=|=|:)\\s*[\'"]?(?<currentValue>[^\\s\'"]+)',
      ],
    },
  ],
}
